# =============================================================================
# StageGear Dashboard · variáveis de ambiente do front-end
# -----------------------------------------------------------------------------
# Copie para .env.local (já ignorado pelo Git) e preencha:
#   cp .env.example .env.local
#
# IMPORTANTE
# - Toda variável VITE_* é embutida no bundle JavaScript no momento do build
#   e fica visível para qualquer pessoa que abrir o site. Coloque aqui SOMENTE
#   valores públicos por design.
# - NUNCA coloque a chave service_role do Supabase neste arquivo nem em
#   nenhuma variável VITE_*. Ela só existe no ambiente das Edge Functions.
# - Alterou um valor? Rode `npm run build` de novo: o valor antigo fica no
#   dist/ até o próximo build.
# =============================================================================

# URL do projeto Supabase.
# Onde encontrar: Supabase Studio > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://SEU-PROJECT-REF.supabase.co

# Chave pública "anon" do projeto (role = anon). Quem protege os dados é o RLS.
# Onde encontrar: Supabase Studio > Project Settings > API > Project API keys > anon public
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# -----------------------------------------------------------------------------
# Secrets das Edge Functions (NÃO pertencem a este arquivo)
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY são injetados
# automaticamente pelo Supabase no runtime das funções em supabase/functions/.
# Não é preciso configurá-los à mão. Veja a seção 6 do README.
# -----------------------------------------------------------------------------
